# --- Zugang (simuliertes myWIFI-Login im Pilot) ---
# Geheimer Schlüssel zum Signieren der Sitzungs-Cookies (mind. 32 Zeichen, zufällig).
SESSION_SECRET=bitte-durch-einen-langen-zufaelligen-wert-ersetzen
# Zugangscode für Testpersonen (wird intern verteilt).
PILOT_ACCESS_CODE=pilot-2026
# Zugangscode für das Administrationsdashboard.
ADMIN_ACCESS_CODE=admin-2026

# --- KI (OpenAI) ---
# Ohne Schlüssel läuft die App im Demo-Modus mit regelbasierten Antworten (ohne KI).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Websuche für Recherche mit Quellen (true/false)
OPENAI_WEB_SEARCH=true

# --- Kostenschätzung (Annahmen, bitte mit aktuellen Anbieterpreisen abgleichen) ---
PRICE_INPUT_EUR_PER_MTOK=0.25
PRICE_OUTPUT_EUR_PER_MTOK=2.00
PRICE_WEB_SEARCH_EUR_PER_CALL=0.01

# --- Datenbank (Supabase, EU-Region) ---
# Ohne diese Werte wird lokal in .data/store.json gespeichert (nur für Entwicklung).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
